{
  "name": "@rmbdo/collector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install-browser": "playwright install chromium",
    "collect:fishing": "tsx src/scrapers/fishing.ts",
    "collect:grindspots": "tsx src/scrapers/grindSpots.ts",
    "collect:market": "tsx src/scrapers/market.ts",
    "collect:crafting": "tsx src/scrapers/crafting.ts",
    "collect:daily": "npm run collect:market && npm run collect:crafting",
    "collect:all": "npm run collect:fishing && npm run collect:grindspots && npm run collect:market && npm run collect:crafting"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
