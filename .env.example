# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres / Supabase --------------------------------------------------
# Required. Supabase Project Settings -> Database -> Connection string
# (use the "Transaction" pooler URI for serverless/scripts, port 6543).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres"

# Optional: direct (non-pooled) connection, used by scripts/migrate.mjs for
# DDL (CREATE TABLE etc.) since some poolers don't support prepared
# statements/DDL well. Supabase Project Settings -> Database -> Connection
# string -> "Session" (port 5432). Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Optional: only needed if the Next.js app ever calls Supabase client SDK
# directly (auth/storage/realtime) instead of going through DATABASE_URL.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only (API routes/scripts). NEVER expose to the browser/client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Collector -------------------------------------------------------------
# How long (ms) to wait between actions against bdolytics.com. Keep this
# generous - we got Cloudflare rate-limited once already during manual testing.
COLLECTOR_MIN_DELAY_MS=3000
COLLECTOR_MAX_DELAY_MS=8000
# Run the collector browser with a visible window (useful for first-run
# debugging / solving a Cloudflare challenge manually). "true" or "false".
COLLECTOR_HEADFUL=false

# Lets GET /api/crafting-recipes/[slug]/ingredients scrape a recipe's
# ingredient tree live on a cache miss, instead of just returning 404.
# ONLY for a local/self-hosted dev server with Playwright installed - MUST
# stay unset/false on Vercel (no Playwright there) or any shared/production
# deployment, since it spawns a real stealth browser per uncached request.
# ENABLE_ON_DEMAND_SCRAPE=true

# --- Google Sheets inventory sync ------------------------------------------
# Apps Script Web App URL (Deploy -> New deployment -> Web app) backing
# /api/sync/inventory. See docs/sync/Code.gs for the script to deploy.
# GOOGLE_SHEETS_WEBHOOK_URL=
