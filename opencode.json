{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ssh-remote": {
      "type": "local",
      "command": ["npx", "-y", "@zachflint/ssh-mcp-server"],
      "environment": {
        "SSH_HOST": "192.168.1.248",
        "SSH_USERNAME": "kanfullbuster",
        "SSH_PRIVATE_KEY": "C:\\Users\\telep\\.ssh\\id_ed25519"
      },
      "timeout": 60000,
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["node", "C:\\Users\\telep\\AppData\\Roaming\\npm\\node_modules\\@0xshariq\\docker-mcp-server\\dist\\index.js"],
      "environment": {
        "DOCKER_HOST": "ssh://kanfullbuster@192.168.1.248",
        "DOCKER_SSH_KEY": "~/.ssh/id_ed25519"
      },
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare": {
      "type": "local",
      "command": ["npx", "-y", "@cloudflare/mcp-server-cloudflare"],
      "environment": {
        "CLOUDFLARE_API_TOKEN": "{env:CLOUDFLARE_API_TOKEN}"
      },
      "timeout": 60000,
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\Users\\telep\\.config\\opencode\\pg-tunnel.ps1"],
      "timeout": 60000,
      "enabled": true
    },
    "n8n": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "environment": {
        "N8N_API_URL": "http://192.168.1.248:5678",
        "N8N_API_KEY": "{env:N8N_API_KEY}",
        "WEBHOOK_SECURITY_MODE": "permissive"
      },
      "timeout": 60000,
      "enabled": true
    }
  }
}
