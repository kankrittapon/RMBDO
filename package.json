{
  "name": "rmbdo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "collector"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "collect:fishing": "npm run collect:fishing -w collector",
    "collect:grindspots": "npm run collect:grindspots -w collector",
    "collect:all": "npm run collect:all -w collector",
    "normalize": "node --env-file=.env scripts/normalize.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "next": "^14.2.14",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
