{
  "name": "rmbdo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "collector"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "import:nodes": "node --env-file=.env scripts/import-node-resources.mjs",
    "collect:fishing": "npm run collect:fishing -w collector",
    "collect:grindspots": "npm run collect:grindspots -w collector",
    "collect:market": "npm run collect:market -w collector",
    "collect:crafting": "npm run collect:crafting -w collector",
    "collect:daily": "npm run collect:daily -w collector",
    "collect:crafting-detail-batch": "npm run collect:crafting-detail-batch -w collector",
    "collect:bdocodex": "npm run collect:bdocodex -w collector",
    "collect:th-names": "npm run collect:th-names -w collector",
    "collect:th-names-bdolytics": "npm run collect:th-names-bdolytics -w collector",
    "collect:th-names-lists": "npm run collect:th-names-lists -w collector",
    "th-names-items": "node --env-file=.env scripts/th-names-items.mjs",
    "bdocodex-find": "node --env-file=.env scripts/bdocodex-find.mjs",
    "collect:all": "npm run collect:all -w collector",
    "normalize": "node --env-file=.env scripts/normalize.mjs",
    "backfill:icons": "node --env-file=.env scripts/backfill-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "next": "^14.2.14",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
